DATABASE_URL=postgresql://usuario:password@localhost:5432/kernel
JWT_SECRET=cambia_este_secreto_en_produccion
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Circuit breaker de seguridad (lockdown automático)
# false = enforcing (bloquea activamente) — usar en producción
# true  = shadow mode (solo observa y registra, no bloquea) — usar para diagnóstico
LOCKDOWN_SHADOW_MODE=false
