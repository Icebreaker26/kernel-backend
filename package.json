{
  "name": "kernel-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "generate:module": "node scripts/generateModule.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/spa": "^1.0.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.12.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "globalTeardown": "./tests/globalTeardown.js"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json"
  },
  "node-pg-migrate": {
    "migrations-dir": "migrations",
    "migration-file-language": "js"
  }
}
